# ClapOut landing page environment
#
# Copy to `.env` (or `.env.local`) and adjust. Both variables have localhost
# defaults baked into the code, so `npm run dev` works with no .env at all.
# Only VITE_-prefixed variables are exposed to the browser bundle — never put
# secrets in this file.

# Base URL of the ClapOut backend API (campaigns are fetched from
# `${VITE_API_BASE_URL}/public/campaigns`). If the request fails, the landing
# page silently falls back to the bundled static campaign list.
# Production: TBD (e.g. https://api.clapoutcreators.com/api/v1)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Origin of the ClapOut Studio platform. Campaign cards link to
# `${VITE_PLATFORM_URL}/campaigns/<slug>`.
# Production: TBD (e.g. https://studio.clapoutcreators.com)
VITE_PLATFORM_URL=http://localhost:4200
